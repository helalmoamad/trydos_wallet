<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for the wallet example app.

  Android 9 (API 28) and newer block plaintext HTTP by default, which breaks
  connecting to a local/staging wallet backend over `http://`. This re-enables
  it. Trust anchors stay at the system store only — the debug variant of this
  file (src/debug/res/xml/network_security_config.xml) additionally trusts
  user-installed CAs so an HTTPS debugging proxy can be used.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
